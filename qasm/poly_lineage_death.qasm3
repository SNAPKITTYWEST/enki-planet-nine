// poly_lineage_death.qasm3
// Polynomial-time lineage state evolution + terminal death collapse
// 3-qubit register: 8 generational depth states (g = 0..7)
// death_ancilla: entangled via half-life decay λ = ln(2)
// Author: Ahmad Ali Parr

OPENQASM 3.0;
include "stdgates.inc";

// ============================================================
// DECAY CONSTANT
// λ = ln(2) ≈ 0.693147 — half-life decay for mortality coupling
// When cp(DECAY_LAMBDA) applied: P(death=1) = sin²(λ/2) ≈ 0.107
// ============================================================
const float[64] DECAY_LAMBDA = 0.69314718;    // ln(2)

// ============================================================
// REGISTERS
// lineage_register: encodes generational depth g ∈ {0..7}
//   |000⟩ = generation 0 (root)
//   |111⟩ = generation 7 (maximum depth / entropy saturation)
// death_ancilla: |0⟩ = viable,  |1⟩ = terminal collapse
// ============================================================
qubit[3] lineage_register;
qubit[1] death_ancilla;
bit[3]   lineage_readout;
bit[1]   death_readout;

// ============================================================
// INITIALIZE LINEAGE TREE
// |ψ₀⟩ = H⊗³|000⟩ = (1/√8)∑_g |g⟩
// Uniform superposition over 8 generational depths
// Per-state probability: |⟨g|ψ₀⟩|² = 1/8 = 0.125
// ============================================================
def initialize_lineage_tree(qubit[3] reg) {
    h reg[0];
    h reg[1];
    h reg[2];
}

// ============================================================
// POLYNOMIAL TIME PHASE SCALING
// Maps generational depth to phase weight ~ k·π/2^(d)
// Encodes T(N) = N^k polynomial complexity structure
// reg[0] = shallowest (g ∝ 1)  → phase π/4
// reg[1] = middle     (g ∝ 2)  → phase π/2
// reg[2] = deepest    (g ∝ 4)  → phase π
// Phase doubles per qubit: linear in qubit index → quadratic in N
// ============================================================
def apply_polynomial_scaling(qubit[3] reg) {
    rz(pi / 4.0) reg[0];   // Depth-1 complexity phase
    rz(pi / 2.0) reg[1];   // Depth-2 complexity phase
    rz(pi) reg[2];          // Depth-4 complexity phase (saturated)
}

// ============================================================
// TERMINAL DEATH COLLAPSE
// Entangles deepest generation (reg[2]) with death ancilla
// cp(DECAY_LAMBDA): controlled phase = ln(2)
// Models V(t): lineages near entropy saturation (g=7) collapse
// U_decay |g⟩_L|0⟩_D = cos(λ/2)|g⟩|0⟩ + i sin(λ/2)|g⟩|1⟩
//
// P(death_ancilla = 1 | reg[2] = 1) ∝ sin²(ln(2)/2) ≈ 0.107
// GenealogyComplexity.mortality_terminal_state: deterministic when t ≥ t_max
// ============================================================
def apply_mortality_collapse(qubit[3] reg, qubit[1] death) {
    h death[0];                           // Prepare ancilla in |+⟩
    cp(DECAY_LAMBDA) reg[2], death[0];    // Decay coupling to deepest generation
}

// ============================================================
// EXECUTION PIPELINE
// 1. Initialize: uniform superposition over all generations
// 2. Scale: polynomial complexity phase encoding
// 3. Collapse: mortality entanglement on deepest qubit
// 4. Measure: lineage depth + death outcome
// ============================================================
initialize_lineage_tree(lineage_register);
apply_polynomial_scaling(lineage_register);
apply_mortality_collapse(lineage_register, death_ancilla);

lineage_readout = measure lineage_register;
death_readout   = measure death_ancilla;

// ============================================================
// READOUT INTERPRETATION
// lineage_readout[2:0]: generational depth g ∈ {0..7}
// death_readout[0]:
//   0 → lineage viable   (t < t_max, S < S_max)
//   1 → terminal collapse (DEATH: t ≥ t_max or S ≥ S_max)
//
// Lean 4 proof: GenealogyComplexity.mortality_terminal_state
//   ∀ t ≥ t_max → check_mortality(t, t_max) = false
// ============================================================
