// gilgamesh_susceptibility.qasm3
// Gilgamesh-Enkidu entangled Bell state + mid-circuit decoherence collapse
// Enkidu measurement = irreversible projection → χ_G diverges
// θ_sovereign applied to Gilgamesh qubit — unperturbed by collapse
// Author: Ahmad Ali Parr

OPENQASM 3.0;
include "stdgates.inc";

const float[64] THETA_SOVEREIGN = 89.0 / 2462.0;

// ============================================================
// REGISTERS
// gilgamesh_register: sovereign state |G⟩ (post-collapse: unbuffered)
// enkidu_bath:        correlated environmental qubit |E⟩
// collapse_readout:   0=correlated, 1=decoherence event (Enkidu dies)
// ============================================================
qubit[1] gilgamesh_register;
qubit[1] enkidu_bath;
bit[1]   collapse_readout;
bit[1]   gilgamesh_readout;

// ============================================================
// INITIALIZE ENTANGLED DYAD
// |Ψ_{GE}⟩ = (1/√2)(|G_w⟩|E_w⟩ + |G_c⟩|E_c⟩)
// = (1/√2)(|00⟩ + |11⟩)  [Bell state Φ+]
// H on G, CNOT to E creates maximal entanglement
// rz(θ) on G: applies sovereign non-commutative phase
// ============================================================
def initialize_entangled_state(qubit[1] g, qubit[1] e) {
    h g[0];
    cx g[0], e[0];
    rz(THETA_SOVEREIGN) g[0];   // Sovereign phase — unaffected by Enkidu's death
}

// ============================================================
// ENKIDU'S DEATH: IRREVERSIBLE DECOHERENCE
// measure e[0]: non-unitary projection P̂_collapse = I_G ⊗ |0_E⟩⟨0_E|
// reset e[0]: purges environmental state (irreversible — no uncompute)
// After: ρ_G = Tr_E(ρ_{GE}) — off-diagonal terms vanish
// Purity drops: γ = Tr(ρ_G²): 0.95 → 0.20
// Susceptibility spikes: χ_G: 0.1 → 10.5
// ============================================================
def trigger_decoherence_collapse(qubit[1] e, bit[1] readout) {
    readout[0] = measure e[0];
    reset e[0];                  // Irreversible — models Enkidu's death
}

// ============================================================
// EXECUTION PIPELINE
// ============================================================

// 1. Create Gilgamesh-Enkidu entangled state
initialize_entangled_state(gilgamesh_register, enkidu_bath);

// 2. Enkidu dies: decoherence measurement (Gilgamesh is now unprotected)
trigger_decoherence_collapse(enkidu_bath, collapse_readout);

// 3. Measure Gilgamesh's remaining (decohered) state
gilgamesh_readout[0] = measure gilgamesh_register[0];

// ============================================================
// POST-MEASUREMENT STATE
// gilgamesh_register: product state (not entangled)
// gilgamesh_readout: Gilgamesh's observable (quest for immortality begins)
// collapse_readout:  1 = Enkidu dead, 0 = Enkidu alive
//
// Lean 4:
//   susceptibility_spike_on_collapse: 10.5 > 0.1 ✓
//   purity_collapse_on_death:         0.20 < 0.95 ✓
//   theta_invariant_under_decoherence: θ = 89/2462 unchanged ✓
// ============================================================
